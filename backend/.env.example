# Copy this file to .env and fill in your Supabase project credentials.
# Never commit .env to version control.

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-anon-or-service-role-key>

# Optional tuning (all have sensible defaults — see main.py)
# FLAG_EFFICIENCY_THRESHOLD=50
# FLAG_SUBMISSION_WINDOW=3
# DOWNTIME_REASON_THRESHOLD=60
# IMPOSSIBLE_EFFICIENCY_MIN=0
# IMPOSSIBLE_EFFICIENCY_MAX=150
# RISK_MEDIUM_THRESHOLD_PCT=10
# RISK_HIGH_THRESHOLD_PCT=25
# RISK_OUTLIER_THRESHOLD_PCT=50

# Optional: once Adithya's time_prediction service is live, point at it here
# and risk_analyze will call it instead of using its own mock predictor.
# TIME_PREDICTION_URL=http://localhost:8002
