# Copy this file to .env and fill in your Supabase project credentials.
# Never commit .env to version control.

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-anon-or-service-role-key>

# Secret used to sign this service's OWN JWTs (employee-login / floor-manager
# login). This is separate from Supabase Auth's keys above — pick a long
# random string and keep it secret.
JWT_SECRET=change-me-to-a-long-random-string

# Optional overrides (defaults shown)
# LOW_EFFICIENCY_THRESHOLD=50
# IMPOSSIBLE_MIN=0
# IMPOSSIBLE_MAX=150

# Port to run this service on (the client expects 8001 by default — see
# client/.env.local.example → NEXT_PUBLIC_RISK_ANALYZE_API_URL)
PORT=8001
