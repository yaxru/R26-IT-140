# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Shared secret used to sign/verify the secure-link token issued by
# Component 2 (Real-Time Efficiency Monitoring). Must match Component 2's config.
SECURE_LINK_SECRET=change-me-shared-with-component2

# Frontend URL used in generated assessment links. The web client builds links
# from its current origin, but this is also used by direct API consumers.
FRONTEND_BASE_URL=http://localhost:3000/assessment

# Comma-separated browser origins allowed to call this API.
STRESS_CORS_ORIGINS=http://localhost:3000,^http://192\.168\.1\.(?:25[0-5]|2[0-4]\d|1\d{2}|[1-9]?\d):3000$

# Service
PORT=5003
FLASK_ENV=development
