# Copy this file to .env.local and fill in your Supabase project credentials
# (Settings → API in the Supabase dashboard). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# worker_reallocation service (Yasiru's) — stations, skill matrix, recommendations
NEXT_PUBLIC_API_URL=http://localhost:8000

# risk_analyze service (this — the Digital Job Card + flags/notifications)
NEXT_PUBLIC_RISK_API_URL=http://localhost:8001
