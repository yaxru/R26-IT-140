# Copy this file to .env.local and fill in your values.

# --- Supabase (used by the main StitchFlow dashboard: floor-map,
#     worker-reallocation, header/session, etc.) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# --- risk_analyze service (Employee + Floor Manager/Supervisor "Digital Job
#     Card" module, at /risk-analyze). This is a separate backend and auth
#     system from Supabase above — see services/risk_analyze/README.md.
#     Defaults to http://localhost:8001 if unset. ---
NEXT_PUBLIC_RISK_ANALYZE_API_URL=http://localhost:8001
